#!/bin/bash
set -e

case "$1" in
    configure)
        # Install nginx configuration
        if [ -f /usr/share/hifiberry-vu-meter/nginx/hifiberry-vu-meter.nginx ]; then
            mkdir -p /etc/nginx/hifiberry-api.d
            cp /usr/share/hifiberry-vu-meter/nginx/hifiberry-vu-meter.nginx /etc/nginx/hifiberry-api.d/hifiberry-vu-meter.nginx
            echo "Installed VU meter nginx configuration."

            # Test and reload nginx
            if nginx -t 2>/dev/null; then
                invoke-rc.d nginx reload >/dev/null 2>&1 || true
                echo "nginx reload requested"
            else
                echo "Warning: nginx configuration test failed"
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# Automatically added by dh_installsystemduser/13.24.2
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -z "$DPKG_ROOT" ] ; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper --user unmask 'vu-meter.service' >/dev/null || true

		# was-enabled defaults to true, so new installations run enable.
		if deb-systemd-helper --quiet --user was-enabled 'vu-meter.service' ; then
			# Enables the unit on first installation, creates new
			# symlinks on upgrades if the unit file has changed.
			deb-systemd-helper --user enable 'vu-meter.service' >/dev/null || true
		else
			# Update the statefile to add new symlinks (if any), which need to be
			# cleaned up on purge. Also remove old symlinks.
			deb-systemd-helper --user update-state 'vu-meter.service' >/dev/null || true
		fi
	fi
fi
# End automatically added section


exit 0
